# ─── Supabase / PostgreSQL ───────────────────────────────────────────────
SUPABASE_HOST=your-project.pooler.supabase.com
SUPABASE_DB=postgres
SUPABASE_USER=postgres.your-project-ref
SUPABASE_PASSWORD=your-password

# ─── Kafka (Upstash free tier) ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=your-cluster.upstash.io:9092
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="..." password="...";

# ─── Redis (Upstash free tier) ──────────────────────────────────────────
REDIS_HOST=your-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true

# ─── token-service ──────────────────────────────────────────────────────
# Dedicated to offline allowance JWTs only. Do not reuse a session JWT key.
OFFLINE_TOKEN_SIGNING_SECRET=generate-with-openssl-rand-base64-64
OFFLINE_TOKEN_ISSUER=paron-offline-token
# Gateway session verification uses a separate RS256 public key.
JWT_PUBLIC_KEY=
# Session issuer used by auth-service and verified by api-gateway.
SESSION_JWT_PRIVATE_KEY=
SESSION_JWT_ISSUER=paron-demo-auth
SESSION_JWT_AUDIENCE=paron-wallet
DEMO_AUTH_USERNAME=demo-customer
DEMO_AUTH_PASSWORD=replace-with-a-long-demo-only-password
AUTH_SERVICE_URL=http://localhost:8086

# ─── Inter-service URLs (for local dev) ─────────────────────────────────
TOKEN_SERVICE_URL=http://localhost:8081
LEDGER_SERVICE_URL=http://localhost:8082

# PayPal sandbox: create these in the PayPal Developer Dashboard. Keep real values in .env only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
